{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)"
    ]
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "python3 /home/user/.claude/hooks/usage_guard.py statusline"
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true,
    "github@anthropic-plugin-directory": true,
    "security-guidance@anthropic-plugin-directory": true,
    "stripe@anthropic-plugin-directory": true
  },
  "modelSettings": {
    "claude-sonnet-4-6": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/.claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/user/.claude/hooks/block_env.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "promptSuggestionEnabled": false,
  "theme": "dark",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
